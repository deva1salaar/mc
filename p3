#pgm3
import numpy as np
import matplotlib.pyplot as plt
from tensorflow.keras import datasets, layers, models
 # Load + normalise
(x_train, y_train), (x_test, y_test) = datasets.cifar10.load_data()
x_train, x_test = x_train / 255.0, x_test / 255.0
class_names = ["airplane", "automobile", "bird", "cat", "deer",
               "dog", "frog", "horse", "ship", "truck"]
 # CNN: Conv -> Pool -> Conv -> Pool -> Conv -> Flatten -> Dense
model = models.Sequential([
    layers.Input(shape=(32, 32, 3)),
    layers.Conv2D(32, (3, 3), activation="relu"),
    layers.MaxPooling2D((2, 2)),
    layers.Conv2D(64, (3, 3), activation="relu"),
    layers.MaxPooling2D((2, 2)),
    layers.Conv2D(64, (3, 3), activation="relu"),
    layers.Flatten(),
    layers.Dense(64, activation="relu"),
    layers.Dense(10, activation="softmax"),
])
model.compile(optimizer="adam", loss="sparse_categorical_crossentropy", metrics=["accuracy"])
 
# Train + evaluate
history = model.fit(x_train, y_train, epochs=5, validation_data=(x_test, y_test))
loss, acc = model.evaluate(x_test, y_test, verbose=0)
print(f"Test Accuracy: {acc:.4f}")
 
# Accuracy graph
plt.plot(history.history["accuracy"], label="Train")
plt.plot(history.history["val_accuracy"], label="Validation")
plt.xlabel("Epoch"); plt.ylabel("Accuracy"); plt.legend(); plt.show()
 
# Predict 10 random test images
idx = np.random.randint(0, len(x_test), 10)
pred = np.argmax(model.predict(x_test[idx], verbose=0), axis=1)
plt.figure(figsize=(12, 5))
for k, i in enumerate(idx):
    plt.subplot(2, 5, k + 1)
    plt.imshow(x_test[i])
    plt.title(f"True: {class_names[y_test[i][0]]}\nPred: {class_names[pred[k]]}", fontsize=9)
    plt.axis("off")
plt.tight_layout()
plt.show()
