#include <LPC214x.H>
#include <stdio.h>
// LCD Functions
void LCD_Init(void);
void LCD_Command(unsigned char cmd);
void LCD_Data(unsigned char data);
void LCD_Display(const char *str);
// Keypad Functions
void Keypad_Init(void);
unsigned char Keypad_Scan(void);
int main() {
unsigned char key;
LCD_Init();
Keypad_Init();
LCD_Display("Keypad Test:");
LCD_Command(0xC0); // Move to second line
while(1) {
key = Keypad_Scan();
if(key != 0xFF) {
LCD_Data(key);
while(Keypad_Scan() != 0xFF); // Wait for key release
}
}
}
// LCD Implementation
void LCD_Init(void) {
PINSEL0 = 0x00000000; // Configure P0.0 to P0.7 as GPIO
IODIR0 = 0x0000FF3F; // P0.0 to P0.5 and P0.8 to P0.15 as output
delay(20000);
LCD_Command(0x38); // 8-bit mode, 2-line, 5x7 font
LCD_Command(0x0C); // Display on, cursor off
LCD_Command(0x06); // Entry mode - auto increment
LCD_Command(0x01); // Clear display
delay(20000);
}
void LCD_Command(unsigned char cmd) {
IOSET0 = cmd << 8; // Put command on data lines (P0.8-P0.15)
IOCLR0 = 0x0000003F; // Clear control lines
IOSET0 = 0x00000020; // RS=0, RW=0, EN=1
delay(1000);
IOCLR0 = 0x00000020; // EN=0
delay(10000);
}
void LCD_Data(unsigned char data) {
IOSET0 = data << 8; // Put data on data lines (P0.8-P0.15)
IOSET0 = 0x00000010; // RS=1, RW=0
IOSET0 = 0x00000020; // EN=1
delay(1000);
IOCLR0 = 0x00000020; // EN=0
delay(10000);
}
void LCD_Display(const char *str) {
while(*str) {
LCD_Data(*str++);
}
}
// Keypad Implementation
void Keypad_Init(void) {
PINSEL1 = 0x00000000; // Configure P0.16 to P0.23 as GPIO
IODIR0 = 0x00F00000; // P0.20 to P0.23 as output (rows), P0.16 to P0.19 as input (cols)
}
unsigned char Keypad_Scan(void) {
const unsigned char keymap[4][4] = {
{'1','2','3','A'},
{'4','5','6','B'},
{'7','8','9','C'},
{'*','0','#','D'}
};
int row, col;
for(row=0; row<4; row++) {
IOCLR0 = 0x00F00000; // Clear all rows
IOSET0 = (1 << (20 + row)); // Activate current row
for(col=0; col<4; col++) {
if(!(IOPIN0 & (1 << (16 + col)))) { // Check if column is low
while(!(IOPIN0 & (1 << (16 + col)))); // Wait for key release
return keymap[row][col];
}
}
}
return 0xFF; // No key pressed
}
void delay(unsigned int count) {
unsigned int i;
for(i=0; i<count; i++);
}
