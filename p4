AREA SUM_ARRAY, CODE, READONLY
ENTRY
 LDR R0, =ARRAY_16BIT ; 
 LDR R1, =RESULT_32BIT ; 
 MOV R2, #0 ; 
 LDR R3, =ARRAY_LENGTH ; 
 LDR R3, [R3] ; 
SUM_LOOP
 LDRH R4, [R0], #2 ; 
 ADD R2, R2, R4 ; 
 SUBS R3, R3, #1 ; 
 BNE SUM_LOOP ; 
 STR R2, [R1] ; 
stop B stop
AREA RAM_DATA, DATA, READWRITE
RESULT_32BIT DCD 0 ; 
AREA ROM_DATA, DATA, READONLY
ARRAY_16BIT DCW 0x1111, 0x2222, 0x3333, 0x4444, 0x5555 ; 16-bit array
ARRAY_LENGTH DCD 5 ;
END
